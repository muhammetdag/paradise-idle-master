{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paradise Idle Master",
  "version": "1.0.1",
  "identifier": "com.paradisedev.idlemaster",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Paradise Idle Master",
        "width": 420,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "steam_api64.dll"
    ],
    "publisher": "Paradise Development",
    "copyright": "Copyright © 2026 Paradise Development",
    "category": "Utility",
    "shortDescription": "Steam card idle application",
    "longDescription": "Paradise Idle Master helps you idle Steam games to collect trading cards efficiently."
  }
}
